rules_version = '2';

// Studio Inventory security rules.
//
// Access is email + password sign-in gated on an allowlist. Anyone can create
// an account, but it can't read or write anything until BOTH:
//   1. the email address is verified (proves they own it — otherwise anyone
//      could register an allowlisted address first), and
//   2. a doc for that lowercased email exists in /staff.
// Admins manage /staff from the app's Access page. Owners are hard-coded so the
// studio can never lock itself out; keep OWNER_EMAILS in src/lib/auth.tsx in
// sync with the list below.
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return verified() && myEmail() in ['lachlan.odea@wisetechglobal.com'];
    }

    function staffDoc() {
      return /databases/$(database)/documents/staff/$(myEmail());
    }

    function isStaff() {
      return isOwner() || (verified() && exists(staffDoc()));
    }

    function isAdmin() {
      return isOwner() || (verified() && exists(staffDoc()) && get(staffDoc()).data.role == 'admin');
    }

    function positiveInt(v) {
      return v is int && v >= 0;
    }

    // ---- Photo sessions (QR code → phone camera) ----
    // A phone with no account can set an item's photo only while it holds the
    // ID of a live session that lists that item. The ID is an unguessable
    // Firestore auto-ID, shared only in the QR code shown at the desk.

    function photoSession(sessionId) {
      return /databases/$(database)/documents/photoSessions/$(sessionId);
    }

    function sessionAllows(sessionId, itemId) {
      return sessionId is string
        && itemId is string
        && exists(photoSession(sessionId))
        && get(photoSession(sessionId)).data.expiresAt > request.time
        && itemId in get(photoSession(sessionId)).data.itemIds;
    }

    function cloudinaryUrl(v) {
      return v is string && v.size() <= 500 && v.matches('https://res[.]cloudinary[.]com/.+');
    }

    // The allowlist. Doc ID is the lowercased email.
    match /staff/{email} {
      // Anyone verified may read their OWN entry — that's how the app decides
      // between "no access" and letting them in.
      allow get: if isStaff() || (verified() && email == myEmail());
      allow list: if isStaff();
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'member'];
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && positiveInt(request.resource.data.totalQty)
        && positiveInt(request.resource.data.availableQty)
        && request.resource.data.availableQty <= request.resource.data.totalQty;
      // A phone in a photo session: the photo fields only, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl', 'photoPath', 'photoSessionId', 'updatedAt'])
        && sessionAllows(request.resource.data.photoSessionId, itemId)
        && cloudinaryUrl(request.resource.data.photoUrl)
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath.size() <= 300
        && request.resource.data.updatedAt == request.time;
      allow delete: if isStaff();
    }

    match /photoSessions/{sessionId} {
      // Readable by ID — that's how the phone loads it — but only while live.
      allow get: if isStaff() || resource.data.expiresAt > request.time;
      allow list: if isStaff();
      allow create: if isStaff()
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.itemIds is list
        && request.resource.data.itemIds.size() > 0
        && request.resource.data.itemIds.size() <= 2000
        && request.resource.data.items is list
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(12, 'h');
      // Ending a session early sets expiresAt to now; adding an item created
      // mid-session appends to itemIds/items (any staff desk may do this).
      allow update: if isStaff()
        && request.resource.data.itemIds is list
        && request.resource.data.itemIds.size() <= 2000
        && request.resource.data.items is list;
      allow delete: if isStaff();

      match /uploads/{uploadId} {
        allow read: if isStaff();
        allow create: if sessionAllows(sessionId, request.resource.data.itemId)
          && request.resource.data.keys().hasOnly(['itemId', 'itemName', 'url', 'publicId', 'createdAt'])
          && request.resource.data.itemName is string
          && request.resource.data.itemName.size() <= 200
          && cloudinaryUrl(request.resource.data.url)
          && request.resource.data.publicId is string
          && request.resource.data.publicId.size() <= 300
          && request.resource.data.createdAt == request.time;
        // The log of who-photographed-what is append-only.
        allow update, delete: if false;
      }
    }

    match /people/{personId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
      allow delete: if isStaff();
    }

    match /kits/{kitId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.components is list
        && request.resource.data.components.size() <= 100;
      // Kits own no stock and loans carry the kit name, so deleting is safe.
      allow delete: if isStaff();
    }

    match /loans/{loanId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.itemId is string
        && request.resource.data.personId is string
        && request.resource.data.qty is int
        && request.resource.data.qty > 0;
      allow update: if isStaff();
      // Loans are the audit trail — they are never deleted, only returned.
      allow delete: if false;
    }
  }
}
