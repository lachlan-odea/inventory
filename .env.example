# Copy to .env and paste the values from:
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These keys are NOT secrets — they identify the project to the client. Access is
# controlled by firestore.rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to point the app at the local Firebase emulators instead of the
# real project (npm run emulators, then npm run dev:emulated).
VITE_USE_EMULATORS=false

# Photo storage — Cloudinary free tier (no card required), used instead of
# Firebase Storage (which now requires the paid Blaze plan to use at all).
# Dashboard -> Settings -> Upload -> Upload presets -> Add upload preset ->
# Signing mode: Unsigned. Cloud name is on the dashboard home page.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=


# Where a phone opens photo-session QR codes. Leave blank on the deployed site.
# Set it when running locally: a phone usually cannot reach the dev server
# (Windows Firewall, office wifi), so send it to the deployed copy instead.
# Both use the same Firebase project, so it works either way.
VITE_PUBLIC_URL=
