{
  "name": "studio-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Studio Inventory — gear tracking, kits, check-in/check-out, borrowers, due dates",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr src/__smoke.tsx --outDir .smoke --logLevel warn && node .smoke/__smoke.js",
    "emulators": "firebase emulators:start",
    "dev:emulated": "cross-env VITE_USE_EMULATORS=true vite",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
